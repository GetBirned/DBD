# Copy this to .env for local dev (never commit the real .env).
# Set the same values as env vars in Railway for production.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# One-time setup: with the two values above set, run the server and visit
# /api/spotify/login in a browser, approve access, and it'll redirect to
# /api/spotify/callback and print a refresh token. Paste it here, then you
# can remove or protect the /login and /callback routes.
SPOTIFY_REFRESH_TOKEN=

# Must exactly match a Redirect URI registered on the Spotify app.
# Spotify requires 127.0.0.1 rather than localhost for non-HTTPS URIs.
# Local dev: http://127.0.0.1:3001/api/spotify/callback
# Production: https://dbd-production-cb2d.up.railway.app/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback

# Comma-separated Spotify playlist IDs for the 4 highlight playlists
# (the id is the part after /playlist/ in a playlist's share URL).
SPOTIFY_PLAYLIST_IDS=

# From https://steamcommunity.com/dev/apikey (log in, enter any domain name —
# "localhost" is fine for a personal-use key).
STEAM_API_KEY=

# Your 17-digit SteamID64. Find it at https://steamid.io by pasting your
# profile URL. Your profile's game-details privacy must be set to Public
# (Steam app/site → Settings → Privacy Settings → Game details) or the API
# will return nothing.
STEAM_ID=

# Sony has no official public API — this uses the unofficial `psn-api` library.
# One-time setup:
# 1. Log into https://playstation.com in a browser, then visit
#    https://ca.account.sony.com/api/v1/ssocookie — the JSON response's
#    "npsso" value is a 64-char token. Paste it here as PSN_NPSSO.
# 2. Restart the server and visit /api/psn/setup once — it prints a refresh
#    token. Paste that into PSN_REFRESH_TOKEN below.
# 3. Remove PSN_NPSSO (single-use, short-lived) and protect/remove the
#    /api/psn/setup route before deploying.
PSN_NPSSO=
PSN_REFRESH_TOKEN=

# --- GitHub ---------------------------------------------------------------
# Optional. The contribution graph reads GitHub's public calendar page, so it
# needs no API key or token. Only set this to point the widget at a different
# account; it defaults to GetBirned.
GITHUB_USERNAME=
