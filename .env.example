# Copy this to .env for local dev (never commit the real .env).
# Set the same values as env vars in Railway for production.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# One-time setup: with the two values above set, run the server and visit
# /api/spotify/login in a browser, approve access, and it'll redirect to
# /api/spotify/callback and print a refresh token. Paste it here, then you
# can remove or protect the /login and /callback routes.
SPOTIFY_REFRESH_TOKEN=

# Must exactly match a Redirect URI registered on the Spotify app.
# Local dev: http://localhost:3001/api/spotify/callback
# Production: https://<your-railway-domain>/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/spotify/callback

# Comma-separated Spotify playlist IDs for the 4 highlight playlists
# (the id is the part after /playlist/ in a playlist's share URL).
SPOTIFY_PLAYLIST_IDS=
